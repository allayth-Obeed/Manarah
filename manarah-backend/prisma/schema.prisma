generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(USER)
  isActive    Boolean  @default(true)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mosques     Mosque[] @relation("MosqueManager")
  preacher    Preacher? @relation("PreacherUser")
  employee    Employee? @relation("EmployeeUser")
  // ADDED: إشعارات هذا المستخدم الشخصية (تكليف خطبة/إسناد صيانة...) — محفوظة ليراها حتى لو لم يكن متصلاً لحظة الحدث
  notifications Notification[]
}

// Mosque model
model Mosque {
  id          Int        @id @default(autoincrement())
  name        String
  address     String
  city        String
  latitude    Float?
  longitude   Float?
  phone       String?
  capacity    Int?
  status      MosqueStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  managerId   Int?
  manager     User?      @relation("MosqueManager", fields: [managerId], references: [id])
  preachers   PreacherAssignment[]
  announcements Announcement[]
  donations   Donation[]
  // ADDED: ربط اختياري بالتراتبية الجغرافية (محافظة/منطقة/منطقة فرعية/موقع) — اختياري للحفاظ على بيانات المساجد القديمة
  locationId  Int?
  location    Location?  @relation(fields: [locationId], references: [id])
  // ADDED: تذاكر الصيانة والشكاوى المرتبطة بهذا المسجد
  maintenanceTickets MaintenanceTicket[]
  // ADDED: الموظفون العاملون بهذا المسجد (إمام/خطيب/مؤذن/إداري...) — تُستخدم لتوجيه الإشعارات الخاصة بالمسجد لهم
  employees   Employee[]
}

// ADDED: التقسيم الإداري السوري — محافظة → منطقة → منطقة فرعية → موقع (بلدة/حي)
model Province {
  id      Int      @id @default(autoincrement())
  code    String   @unique // مثال: "SY-HM"
  name    String
  regions Region[]
}

model Region {
  id         Int         @id @default(autoincrement())
  code       String      @unique // مثال: "HM-01"
  name       String
  provinceId Int
  province   Province    @relation(fields: [provinceId], references: [id])
  subRegions SubRegion[]
}

model SubRegion {
  id        Int        @id @default(autoincrement())
  code      String     @unique // مثال: "SR-0101"
  name      String
  regionId  Int
  region    Region     @relation(fields: [regionId], references: [id])
  locations Location[]
}

model Location {
  id          Int       @id @default(autoincrement())
  name        String
  subRegionId Int
  subRegion   SubRegion @relation(fields: [subRegionId], references: [id])
  mosques     Mosque[]

  // نفس اسم الموقع يمكن أن يتكرر بمناطق فرعية مختلفة (مثال: "الغنطو" و"جندار" بالبيانات)
  @@unique([subRegionId, name])
}

// Preacher model
model Preacher {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  user        User?      @relation("PreacherUser", fields: [userId], references: [id])
  firstName   String
  lastName    String
  phone       String?
  email       String?
  specialization String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignments PreacherAssignment[]
}

// Employee model
model Employee {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  user        User?      @relation("EmployeeUser", fields: [userId], references: [id])
  firstName   String
  lastName    String
  position    String
  department  String?
  phone       String?
  salary      Float?
  hireDate    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // ADDED: تذاكر الصيانة المسندة لهذا الموظف
  assignedTickets MaintenanceTicket[]
  // ADDED: المسجد الذي يعمل به الموظف (إمام/خطيب/مؤذن/إداري...) — اختياري للحفاظ على سجلات الموظفين السابقة للميزة
  mosqueId    Int?
  mosque      Mosque?    @relation(fields: [mosqueId], references: [id])
}

// Preacher Assignment to Mosque
model PreacherAssignment {
  id          Int        @id @default(autoincrement())
  preacherId  Int
  mosqueId    Int
  // ADDED: نوع التكليف — إمام (تعيين دائم، تعدد المساجد أمر طبيعي) أو خطيب جمعة (لا يجوز تعارضه بنفس اليوم)
  role        AssignmentRole @default(KHATIB)
  startDate   DateTime   @default(now())
  endDate     DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  preacher    Preacher   @relation(fields: [preacherId], references: [id])
  mosque      Mosque     @relation(fields: [mosqueId], references: [id])
  @@unique([preacherId, mosqueId])
}

// Announcement model
model Announcement {
  id          Int        @id @default(autoincrement())
  title       String
  content     String
  mosqueId    Int
  priority    Priority   @default(MEDIUM)
  isActive    Boolean    @default(true)
  startDate   DateTime   @default(now())
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mosque      Mosque     @relation(fields: [mosqueId], references: [id])
}

// Donation model
model Donation {
  id          Int        @id @default(autoincrement())
  donorName   String
  amount      Float
  mosqueId    Int
  donationDate DateTime   @default(now())
  purpose     String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mosque      Mosque     @relation(fields: [mosqueId], references: [id])
}

// ADDED: تذاكر الصيانة والشكاوى — تتبع الأعطال/المشاكل المُبلَّغ عنها بكل مسجد حتى إغلاقها
model MaintenanceTicket {
  id           Int               @id @default(autoincrement())
  title        String
  description  String?
  mosqueId     Int
  mosque       Mosque            @relation(fields: [mosqueId], references: [id])
  priority     Priority          @default(MEDIUM)
  status       MaintenanceStatus @default(OPEN)
  reportedBy   String?
  assignedToId Int?
  assignedTo   Employee?         @relation(fields: [assignedToId], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// ADDED: إشعار شخصي محفوظ لمستخدم — يظهر له حتى لو لم يكن متصلاً بالبث اللحظي وقت وقوع الحدث
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Enums
enum Role {
  ADMIN
  MANAGER
  USER
  PREACHER
  EMPLOYEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MosqueStatus {
  ACTIVE
  MAINTENANCE
}

// ADDED: نوع تكليف الخطيب — إمام دائم أو خطيب جمعة محدد بيوم
enum AssignmentRole {
  IMAM
  KHATIB
}

// ADDED: حالة تذكرة الصيانة/الشكوى
enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
